---
interface Props {
  item: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      type: string;
      tech: string[];
      link?: string;
      github?: string;
      featured?: boolean;
    };
  };
}

const { item } = Astro.props;
---

<div class="group relative rounded-2xl border border-slate-800/80 bg-slate-900/40 hover:bg-slate-900/80 p-6 transition-all duration-300 hover:border-slate-700 flex flex-col justify-between">
  <div class="absolute inset-0 rounded-2xl bg-gradient-to-tr from-purple-500/5 via-transparent to-sky-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>

  <div class="relative z-10">
    <!-- Type / Tag Badge -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="text-xs font-mono font-medium text-sky-400 bg-sky-500/10 border border-sky-500/20 px-2.5 py-1 rounded-full">
        {item.data.type}
      </span>
      {item.data.featured && (
        <span class="text-[10px] font-mono text-purple-400 bg-purple-500/10 border border-purple-500/20 px-2 py-0.5 rounded-full">
          STAR CASE
        </span>
      )}
    </div>

    <!-- Title -->
    <h3 class="text-lg font-bold text-slate-100 group-hover:text-purple-300 transition-colors leading-snug">
      <a href={`/cases/${item.id}`} class="focus:outline-none">
        {item.data.title}
      </a>
    </h3>

    <!-- Description -->
    <p class="mt-2 text-sm text-slate-400 line-clamp-2 leading-relaxed">
      {item.data.description}
    </p>

    <!-- Tech Stack badges -->
    <div class="mt-4 flex flex-wrap gap-1.5">
      {item.data.tech.map((t) => (
        <span class="text-[11px] font-mono text-slate-300 bg-slate-800/80 px-2 py-0.5 rounded">
          {t}
        </span>
      ))}
    </div>
  </div>

  <!-- Action links -->
  <div class="relative z-10 mt-6 pt-4 border-t border-slate-800/60 flex items-center justify-between text-xs font-mono">
    <a
      href={`/cases/${item.id}`}
      class="text-slate-300 hover:text-sky-400 font-medium flex items-center gap-1 transition-colors"
    >
      <span>案例详解</span>
      <span>→</span>
    </a>

    <div class="flex items-center gap-3">
      {item.data.github && (
        <a
          href={item.data.github}
          target="_blank"
          rel="noreferrer"
          class="text-slate-500 hover:text-slate-300 transition-colors"
          title="GitHub Repository"
        >
          CODE ↗
        </a>
      )}
      {item.data.link && (
        <a
          href={item.data.link}
          target="_blank"
          rel="noreferrer"
          class="text-sky-400 hover:text-sky-300 font-semibold transition-colors"
          title="Live Demo"
        >
          DEMO ↗
        </a>
      )}
    </div>
  </div>
</div>
