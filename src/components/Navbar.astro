---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { name: '首页', href: '/' },
  { name: '文章', href: '/posts' },
  { name: '案例库', href: '/cases' },
];
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-slate-950/70 border-b border-slate-800/60">
  <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="group flex items-center gap-2.5">
      <div class="relative w-8 h-8 rounded-lg bg-gradient-to-tr from-sky-500 via-indigo-500 to-purple-500 p-[1px] transition-transform duration-300 group-hover:scale-105 shadow-[0_0_15px_rgba(56,189,248,0.3)]">
        <div class="w-full h-full bg-slate-950 rounded-[7px] flex items-center justify-center">
          <span class="text-xs font-mono font-bold bg-gradient-to-r from-sky-400 to-purple-400 bg-clip-text text-transparent">vG</span>
        </div>
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-sm text-slate-100 tracking-tight group-hover:text-sky-400 transition-colors">
          vGPU<span class="text-sky-400">::</span>Light
        </span>
        <span class="text-[10px] font-mono text-slate-400 leading-none">GRAPHICS & SYSTEMS</span>
      </div>
    </a>

    <!-- Nav Links -->
    <nav class="flex items-center gap-1 sm:gap-2">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all duration-150 ${
              isActive
                ? 'text-sky-400 bg-sky-500/10 border border-sky-500/20'
                : 'text-slate-400 hover:text-slate-200 hover:bg-slate-900/60'
            }`}
          >
            {item.name}
          </a>
        );
      })}

      <div class="h-4 w-[1px] bg-slate-800 mx-1"></div>

      <!-- GitHub Link -->
      <a
        href="https://github.com"
        target="_blank"
        rel="noreferrer"
        class="text-xs font-mono text-slate-400 hover:text-slate-200 px-2 py-1 rounded hover:bg-slate-900 transition-colors flex items-center gap-1"
        aria-label="GitHub"
      >
        <span>GITHUB</span>
        <span class="text-[10px]">↗</span>
      </a>
    </nav>
  </div>
</header>
