---
interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;
const navItems = [
  { name: '文章', href: '/posts' },
  { name: '案例库', href: '/cases' },
];
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-black/80 border-b border-zinc-900/80">
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-8 h-14 flex items-center justify-between">
    <a href="/" class="text-zinc-100 hover:text-white transition-colors shrink-0">
      <span class="font-serif font-normal text-sm sm:text-base tracking-tight text-white">rakuyou’s labyrinth</span>
    </a>
    <div class="flex items-center gap-3 sm:gap-6 text-xs font-mono">
      <nav class="flex items-center gap-3 sm:gap-5" aria-label="主导航">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || currentPath.startsWith(`${item.href}/`);
          return (
            <a href={item.href} aria-current={isActive ? 'page' : undefined}
              class={`nav-link transition-colors py-1 ${isActive ? 'text-white font-medium border-b border-white' : 'text-zinc-200 hover:text-white'}`}>
              {item.name}
            </a>
          );
        })}
      </nav>
      <div class="h-3.5 w-[1px] bg-zinc-800" aria-hidden="true"></div>
      <a href="https://github.com" target="_blank" rel="noreferrer"
        class="text-zinc-400 hover:text-white transition-colors flex items-center gap-1" aria-label="GitHub">
        <span class="hidden sm:inline">GITHUB</span><span class="text-[10px]" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</header>
