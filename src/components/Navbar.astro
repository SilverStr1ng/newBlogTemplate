---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { name: '文章', href: '/posts' },
  { name: '案例库', href: '/cases' },
];
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-black/80 border-b border-zinc-900/80">
  <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 h-14 flex items-center justify-between">
    <!-- Left End: Logo + Title -->
    <a href="/" class="text-zinc-100 hover:text-white transition-colors">
      <span class="font-serif font-normal text-base tracking-tight text-white">
        rakuyou’s labyrinth
      </span>
    </a>

    <!-- Right End: Nav Links + GitHub -->
    <div class="flex items-center gap-6 text-xs font-mono text-zinc-400">
      <nav class="flex items-center gap-5">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`transition-colors py-1 ${
                isActive ? 'text-white font-medium border-b border-white' : 'hover:text-zinc-200'
              }`}
            >
              {item.name}
            </a>
          );
        })}
      </nav>

      <div class="h-3.5 w-[1px] bg-zinc-800"></div>

      <a
        href="https://github.com"
        target="_blank"
        rel="noreferrer"
        class="text-zinc-400 hover:text-white transition-colors flex items-center gap-1"
        aria-label="GitHub"
      >
        <span>GITHUB</span>
        <span class="text-[10px]">↗</span>
      </a>
    </div>
  </div>
</header>
