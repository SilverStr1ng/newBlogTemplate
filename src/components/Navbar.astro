---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { name: '首页', href: '/' },
  { name: '文章', href: '/posts' },
  { name: '案例库', href: '/cases' },
];
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-[#08090d]/80 border-b border-slate-800/50">
  <div class="max-w-4xl mx-auto px-4 h-12 flex items-center justify-between">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2 group">
      <span class="w-1.5 h-1.5 rounded-full bg-sky-400 group-hover:shadow-[0_0_8px_#38bdf8] transition-shadow"></span>
      <span class="font-mono font-semibold text-xs tracking-wider text-slate-200 group-hover:text-white transition-colors">
        vGPU<span class="text-slate-500">/</span>light
      </span>
    </a>

    <!-- Nav Links -->
    <nav class="flex items-center gap-1 sm:gap-2">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`px-2.5 py-1 rounded text-xs font-mono transition-colors ${
              isActive
                ? 'text-sky-400 bg-sky-500/10'
                : 'text-slate-400 hover:text-slate-200'
            }`}
          >
            {item.name}
          </a>
        );
      })}

      <div class="h-3 w-[1px] bg-slate-800 mx-1"></div>

      <a
        href="https://github.com"
        target="_blank"
        rel="noreferrer"
        class="text-xs font-mono text-slate-500 hover:text-slate-300 px-2 py-1 transition-colors"
      >
        GITHUB ↗
      </a>
    </nav>
  </div>
</header>
