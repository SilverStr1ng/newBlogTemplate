---
interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      tags: string[];
      featured?: boolean;
      readTime?: string;
    };
  };
}

const { post } = Astro.props;
const formattedDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(post.data.pubDate);
---

<article class="group relative rounded-2xl border border-slate-800/80 bg-slate-900/40 hover:bg-slate-900/80 p-6 transition-all duration-300 hover:border-slate-700 hover:shadow-[0_4px_30px_rgba(0,0,0,0.5)]">
  <!-- Glowing subtle highlight on hover -->
  <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-sky-500/5 via-transparent to-purple-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>

  <div class="relative z-10 flex flex-col justify-between h-full">
    <div>
      <!-- Meta row -->
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-slate-400 mb-3">
        <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
        <span class="text-slate-700">•</span>
        <span>{post.data.readTime || '5 min read'}</span>
        {post.data.featured && (
          <>
            <span class="text-slate-700">•</span>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-sky-500/10 text-sky-400 border border-sky-500/20">
              FEATURED
            </span>
          </>
        )}
      </div>

      <!-- Title -->
      <h3 class="text-xl font-bold text-slate-100 group-hover:text-sky-300 transition-colors leading-snug">
        <a href={`/posts/${post.id}`} class="focus:outline-none">
          <span class="absolute inset-0" aria-hidden="true"></span>
          {post.data.title}
        </a>
      </h3>

      <!-- Description -->
      <p class="mt-2.5 text-sm text-slate-400 line-clamp-2 leading-relaxed">
        {post.data.description}
      </p>
    </div>

    <!-- Tags -->
    <div class="mt-5 pt-4 border-t border-slate-800/50 flex flex-wrap items-center gap-1.5">
      {post.data.tags.map((tag) => (
        <span class="text-[11px] font-mono text-slate-400 bg-slate-800/60 px-2 py-0.5 rounded-md">
          #{tag}
        </span>
      ))}
    </div>
  </div>
</article>
