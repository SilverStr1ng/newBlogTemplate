---
interface Props {
  post: {
    id: string;
    data: {
      title: string;
      pubDate: Date;
      tags: string[];
      readTime?: string;
    };
  };
}

const { post } = Astro.props;

const d = post.data.pubDate;
const month = String(d.getMonth() + 1).padStart(2, '0');
const day = String(d.getDate()).padStart(2, '0');
const dateStr = `${month}.${day}`;
const mainTag = post.data.tags[0] || '';
---

<a
  href={`/posts/${post.id}`}
  class="group flex items-baseline justify-between gap-4 py-3.5 hover:border-zinc-800 transition-colors"
>
  <div class="flex items-baseline gap-4 sm:gap-6 min-w-0">
    <!-- Date (MM.DD) -->
    <time
      datetime={post.data.pubDate.toISOString()}
      class="text-xs font-mono text-zinc-500 shrink-0 select-none group-hover:text-zinc-400 transition-colors"
    >
      {dateStr}
    </time>

    <!-- Title -->
    <span class="text-sm sm:text-base text-zinc-300 font-normal group-hover:text-white transition-colors truncate">
      {post.data.title}
    </span>
  </div>

  <!-- Tag / Read time -->
  <div class="flex items-center gap-3 shrink-0 text-xs font-mono text-zinc-500">
    {mainTag && (
      <span class="hidden sm:inline text-zinc-500 group-hover:text-zinc-400 transition-colors">
        #{mainTag}
      </span>
    )}
    <span class="group-hover:text-zinc-400 transition-colors">
      {post.data.readTime || '5 min'}
    </span>
  </div>
</a>
