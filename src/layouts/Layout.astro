---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'vGPU::Light — Interactive Graphics, Shaders & Engineering',
  description = 'A blog exploring real-time graphics, WebGPU/WebGL shaders, light simulation, and modern frontend architecture.',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#08090d] text-slate-200 min-h-screen flex flex-col antialiased selection:bg-sky-500/30 selection:text-sky-200">
    <Navbar currentPath={currentPath} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
