---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const formattedDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
}).format(item.data.pubDate);
---

<Layout
  title={`${item.data.title} — 案例库 — vGPU::Light`}
  description={item.data.description}
>
  <article class="max-w-4xl mx-auto px-6 py-12 md:py-16">
    <!-- Breadcrumb -->
    <div class="mb-8">
      <a
        href="/cases"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-slate-400 hover:text-purple-400 transition-colors"
      >
        <span>←</span>
        <span>返回案例库</span>
      </a>
    </div>

    <!-- Header & Info Card -->
    <header class="mb-12 pb-8 border-b border-slate-800">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-xs font-mono text-purple-400 bg-purple-500/10 border border-purple-500/20 px-3 py-1 rounded-full">
          {item.data.type}
        </span>
        <span class="text-xs font-mono text-slate-500">{formattedDate}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white leading-[1.18]">
        {item.data.title}
      </h1>

      <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
        {item.data.description}
      </p>

      <!-- Meta Bar with Action Links -->
      <div class="mt-8 p-5 rounded-2xl border border-slate-800 bg-slate-900/50 flex flex-wrap items-center justify-between gap-4">
        <!-- Tech Badges -->
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="text-xs font-mono text-slate-500 mr-1">TECH:</span>
          {item.data.tech.map((t) => (
            <span class="text-xs font-mono text-slate-300 bg-slate-800 px-2.5 py-1 rounded-md">
              {t}
            </span>
          ))}
        </div>

        <!-- Links -->
        <div class="flex items-center gap-3">
          {item.data.github && (
            <a
              href={item.data.github}
              target="_blank"
              rel="noreferrer"
              class="px-4 py-2 rounded-xl text-xs font-mono bg-slate-800 hover:bg-slate-700 text-slate-200 transition-colors"
            >
              SOURCE CODE ↗
            </a>
          )}
          {item.data.link && (
            <a
              href={item.data.link}
              target="_blank"
              rel="noreferrer"
              class="px-4 py-2 rounded-xl text-xs font-mono bg-purple-500 hover:bg-purple-400 text-slate-950 font-bold transition-colors shadow-[0_0_15px_rgba(168,85,247,0.3)]"
            >
              OPEN LIVE DEMO ↗
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- MDX Content -->
    <div class="prose prose-invert prose-slate max-w-none prose-headings:font-bold prose-headings:text-slate-100 prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-p:text-slate-300 prose-p:leading-relaxed prose-p:my-4 prose-code:text-purple-300 prose-code:bg-slate-900 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-pre:bg-slate-950 prose-pre:border prose-pre:border-slate-800 prose-pre:rounded-2xl">
      <Content />
    </div>
  </article>
</Layout>
