---
import Layout from '../../layouts/Layout.astro';
import CaseListItem from '../../components/CaseListItem.astro';
import { getCollection } from 'astro:content';

const allCases = await getCollection('cases');
const sortedCases = allCases.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="案例库 — vGPU::Light"
  description="实时图形渲染、WebGL/WebGPU 计算着色器与交互式三维作品展示。"
>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-lg font-mono font-semibold tracking-wider text-slate-300 uppercase mb-6">
      案例库 / SHOWCASE ({allCases.length})
    </h1>

    <!-- Pure Minimal List -->
    <div class="divide-y divide-transparent">
      {sortedCases.map((item) => (
        <CaseListItem item={item} />
      ))}
    </div>
  </div>
</Layout>
