---
import Layout from '../layouts/Layout.astro';
import LightHero from '../components/LightHero.svelte';
import PostListItem from '../components/PostListItem.astro';
import CaseListItem from '../components/CaseListItem.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allCases = await getCollection('cases');
const sortedCases = allCases.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="vGPU::Light — 光线、着色器与图形工程"
  description="实时光照着色器、色散棱镜与计算图形学。"
>
  <!-- Optical Light Prism Banner -->
  <LightHero client:load />

  <!-- Content List Area -->
  <div class="max-w-4xl mx-auto px-4 py-10 space-y-12">
    <!-- Section 1: Articles / 文章列表 -->
    <section>
      <div class="flex items-center justify-between pb-3 border-b border-slate-800">
        <h2 class="text-xs font-mono font-semibold tracking-wider text-slate-400 uppercase">
          文章 / WRITINGS
        </h2>
        <a
          href="/posts"
          class="text-xs font-mono text-slate-500 hover:text-sky-400 transition-colors"
        >
          ALL ({allPosts.length}) →
        </a>
      </div>

      <!-- Pure Minimal List -->
      <div class="divide-y divide-transparent">
        {sortedPosts.map((post) => (
          <PostListItem post={post} />
        ))}
      </div>
    </section>

    <!-- Section 2: Cases / 案例库 -->
    <section>
      <div class="flex items-center justify-between pb-3 border-b border-slate-800">
        <h2 class="text-xs font-mono font-semibold tracking-wider text-slate-400 uppercase">
          案例库 / SHOWCASE
        </h2>
        <a
          href="/cases"
          class="text-xs font-mono text-slate-500 hover:text-purple-400 transition-colors"
        >
          ALL ({allCases.length}) →
        </a>
      </div>

      <!-- Pure Minimal List -->
      <div class="divide-y divide-transparent">
        {sortedCases.map((item) => (
          <CaseListItem item={item} />
        ))}
      </div>
    </section>
  </div>
</Layout>
