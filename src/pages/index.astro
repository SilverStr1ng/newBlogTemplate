---
import Layout from '../layouts/Layout.astro';
import LightHero from '../components/LightHero.svelte';
import PostListItem from '../components/PostListItem.astro';
import CaseListItem from '../components/CaseListItem.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allCases = await getCollection('cases');
const sortedCases = allCases.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="rakuyou's labyrinth — 光线、着色器与图形计算"
  description="沉淀关于 WebGPU、GLSL 光学着色器、三维渲染管线及现代前端工程的数字迷宫。"
>
  <!-- 1:1 vgpu-style Optical Light Prism Banner -->
  <LightHero client:load />

  <!-- Content List Area -->
  <div class="max-w-5xl mx-auto px-6 sm:px-8 py-14 space-y-16">
    <!-- Section 1: Articles / 文章列表 -->
    <section>
      <div class="flex items-center justify-between pb-3 border-b border-zinc-800/80">
        <h2 class="text-xs font-mono font-semibold tracking-wider text-zinc-400 uppercase">
          文章 / WRITINGS
        </h2>
        <a
          href="/posts"
          class="text-xs font-mono text-zinc-500 hover:text-white transition-colors"
        >
          ALL ({allPosts.length}) →
        </a>
      </div>

      <!-- Pure Minimal List -->
      <div class="divide-y divide-zinc-900/60">
        {sortedPosts.map((post) => (
          <PostListItem post={post} />
        ))}
      </div>
    </section>

    <!-- Section 2: Cases / 案例库 -->
    <section>
      <div class="flex items-center justify-between pb-3 border-b border-zinc-800/80">
        <h2 class="text-xs font-mono font-semibold tracking-wider text-zinc-400 uppercase">
          案例库 / SHOWCASE
        </h2>
        <a
          href="/cases"
          class="text-xs font-mono text-zinc-500 hover:text-purple-400 transition-colors"
        >
          ALL ({allCases.length}) →
        </a>
      </div>

      <!-- Pure Minimal List -->
      <div class="divide-y divide-zinc-900/60">
        {sortedCases.map((item) => (
          <CaseListItem item={item} />
        ))}
      </div>
    </section>
  </div>
</Layout>
