---
import Layout from '../../layouts/Layout.astro';
import InteractivePostList from '../../components/InteractivePostList.svelte';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const serializedPosts = sortedPosts.map((p) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  pubDate: p.data.pubDate.toISOString(),
  tags: p.data.tags,
  readTime: p.data.readTime,
}));
---

<Layout
  title="文章 — rakuyou's labyrinth"
  description="着色器与实时图形技术文章归档。"
>
  <div class="max-w-6xl mx-auto px-6 sm:px-8 py-12">
    <div class="pb-3 border-b border-zinc-800 mb-8">
      <h1 class="text-xs font-mono font-semibold tracking-wider text-zinc-400 uppercase">
        全部文章 / WRITINGS
      </h1>
    </div>

    <!-- Interactive Client List Island -->
    <InteractivePostList client:load posts={serializedPosts} />
  </div>
</Layout>
