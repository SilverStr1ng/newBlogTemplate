---
import Layout from '../../layouts/Layout.astro';
import InteractivePostList from '../../components/InteractivePostList.svelte';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const serializedPosts = sortedPosts.map((p) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  pubDate: p.data.pubDate.toISOString(),
  tags: p.data.tags,
  readTime: p.data.readTime,
}));

const allTags = Array.from(new Set(allPosts.flatMap((p) => p.data.tags))).sort();
---

<Layout
  title="文章 — vGPU::Light"
  description="着色器与实时图形技术文章。"
>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-lg font-mono font-semibold tracking-wider text-slate-300 uppercase mb-6">
      文章 / WRITINGS ({allPosts.length})
    </h1>

    <!-- Interactive Client List Island -->
    <InteractivePostList client:load posts={serializedPosts} allTags={allTags} />
  </div>
</Layout>
