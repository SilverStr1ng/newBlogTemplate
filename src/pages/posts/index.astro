---
import Layout from '../../layouts/Layout.astro';
import InteractivePostList from '../../components/InteractivePostList.svelte';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const serializedPosts = sortedPosts.map((p) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  pubDate: p.data.pubDate.toISOString(),
  tags: p.data.tags,
  readTime: p.data.readTime,
  featured: p.data.featured,
}));

const allTags = Array.from(new Set(allPosts.flatMap((p) => p.data.tags))).sort();
---

<Layout
  title="全部文章 — vGPU::Light"
  description="探索图形着色器、光线仿真与现代前端架构的技术文章归档。"
>
  <div class="max-w-5xl mx-auto px-6 py-12 md:py-16">
    <!-- Header -->
    <div class="mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-sky-500/10 border border-sky-500/20 text-sky-400 mb-4">
        <span>KNOWLEDGE ARCHIVE</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white">
        文章与探索记录
      </h1>
      <p class="mt-3 text-base text-slate-400 max-w-2xl leading-relaxed">
        沉淀关于 WebGPU、GLSL 光学着色器、三维渲染管线及现代前端孤岛架构的工程实践与深度思考。
      </p>
    </div>

    <!-- Interactive Client List Island -->
    <InteractivePostList client:load posts={serializedPosts} allTags={allTags} />
  </div>
</Layout>
